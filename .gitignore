# Build outputs
build/bin/
release/
*.exe
*.dll

# llama.cpp 本地编译沙箱与一次性构建脚本
.llamacpp-build/
build_llamacpp_*.bat

# Dependencies
node_modules/

# Frontend dist
frontend/dist/

# Runtime data
data/
config.json
router-preset.ini
mcp_servers.json

# Runtime binaries：只允许结构占位文件(txt/md)入库，编译产物一律忽略
runtime/**
!runtime/**/
!runtime/**/*.txt
!runtime/**/*.md
engines_backup/

# 槽位 KV 缓存与冒烟测试运行时数据
build/slots/

# Model files (keep structure txt files)
models/*.gguf
models/*/*.gguf
models/*.md5

# IDE
.trae/
.idea/
.vscode/
# 例外：团队共享的扩展推荐与调试配置需要提交
!.vscode/extensions.json
!.vscode/launch.json
*.swp

# OS
Thumbs.db
.DS_Store

# Test
*.test
*.out
coverage
*_cov
cover.txt
cover_*
coverage_*
tests/**/bing_network_summary.txt
tests/config/go_default_config.json
tests/screenshots/*.png
!tests/screenshots/home.png

# Misc
*.md5
focus_*.ps1

# CodeBuddy project data (runtime/agent data, not source)
.codebuddy/

# Temp / debug / patch files
*.log
*.tmp
*.bak
*.patch
_*.py
_*.go
patch-*.ps1

# Debug crash dumps (generated by local run/debug builds)
build/crash_err.txt
build/crash_out.txt

# Release artifacts
*.zip
security_best_practices_report.md
code_review_report.md

# 运行时大文件：本地模型与 llama.cpp 二进制（build/ 为应用数据根目录）
build/models/
build/runtime/

# Microsoft Store (MSIX) 打包相关：商店构建产物与清单不入仓库
build/windows/msix/
build/store/
build/**/*.msix
build/**/*.msixbundle
